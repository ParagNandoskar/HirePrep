# HirePrep Environment Configuration Example
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:5173
FRONTEND_PROD_URL=http://localhost:5173

# ============================================
# Background Job Processing
# ============================================
# Set to 'false' to disable workers (only enable if main server starts workers)
ENABLE_WORKERS=true

# ============================================
# Database Configuration
# ============================================
# For Docker: mongodb://admin:admin123@mongo:27017/hireprep?authSource=admin
# For Local: mongodb://localhost:27017/hireprep
# For Atlas: mongodb+srv://user:password@cluster.mongodb.net/hireprep
MONGODB_URI=mongodb://localhost:27017/hireprep

# Connection Pool Settings
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=5

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_USERNAME=

# ============================================
# Authentication & Security
# ============================================
# Generate secure random keys for production
JWT_SECRET=your-32-character-random-secret-key-here
JWT_REFRESH_SECRET=your-another-32-char-random-secret-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# External API Keys
# ============================================
# Google Gemini AI API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenAI / Groq Compatibility
# Get Groq key from: https://console.groq.com/keys
OPENAI_API_KEY=gsk_your-groq-api-key-here
GROK_MODEL_NAME=llama-3.3-70b-versatile

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=hireprep-resume
USE_AWS_SECRETS=false

# ============================================
# File Storage
# ============================================
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ============================================
# Python Microservices
# ============================================
PYTHON_NLP_SERVICE_URL=http://localhost:5001
PYTHON_VIDEO_SERVICE_URL=http://localhost:8001
PYTHON_AUDIO_SERVICE_URL=http://localhost:8002

# ============================================
# Speech-to-Text Service
# ============================================
# AssemblyAI (Recommended for simplicity)
# Sign up: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# Or use Groq/OpenAI compatible API (already configured above)
TRANSCRIPTION_API_URL=https://api.groq.com/openai/v1/audio/transcriptions

# ============================================
# Payment Gateway (Razorpay)
# ============================================
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
PAYMENT_MODE=test

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_DISABLED=false

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug

# ============================================
# CORS Settings
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# AI Interview Configuration
# ============================================
MIN_BASELINE_QUESTIONS=3
MAX_FOLLOWUPS_PER_PRIMARY=2
MAX_TOTAL_QUESTIONS=7
