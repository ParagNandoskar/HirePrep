# Use Python 3.9 slim image
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies for audio processing
RUN apt-get update && apt-get install -y \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (new microservice structure)
COPY services/ ./services/

# Copy local models (pre-downloaded, no runtime download)
# IMPORTANT: Run 'python scripts/download_models.py' before building Docker image
# Models are in services/audio_service/local_models/

# Expose port
EXPOSE 8001

# Set environment variables
ENV PYTHONPATH=/app
ENV FLASK_APP=services.audio_service.audio_analysis

# Run the application
CMD ["python", "-m", "services.audio_service.audio_analysis"]
