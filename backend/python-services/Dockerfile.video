# Use Python 3.9 slim image
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies for OpenCV, MediaPipe, and DeepFace
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgstreamer1.0-0 \
    ffmpeg \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY video_analysis.py .
COPY gunicorn_config.py .

# CRITICAL: Copy MediaPipe model file (required for face landmark detection)
COPY face_landmarker.task .

# Expose port
EXPOSE 8001

# Set environment variables
ENV PYTHONPATH=/app
ENV FLASK_APP=video_analysis.py
ENV PORT=8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8001/health', timeout=5)"

# Run the application with Gunicorn (production)
CMD ["gunicorn", "--config", "gunicorn_config.py", "video_analysis:app"]

# For development/testing with Flask dev server, use:
# CMD ["python", "video_analysis.py"]
