{
  "name": "hireprep-backend",
  "version": "1.0.0",
  "description": "Backend for HirePrep - AI-powered interview and job matching platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:watch": "nodemon --exec npm test",
    "setup": "bash setup.sh",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "python:video": "cd python-services && python video_analysis.py",
    "python:audio": "cd python-services && python audio_analysis.py",
    "lint": "echo 'ESLint not configured yet'",
    "format": "echo 'Prettier not configured yet'"
  },
  "keywords": ["node", "express", "mongodb", "ai", "interviews", "jobs"],
  "author": "Duo Developers",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^1.41.0",
    "socket.io": "^4.7.2",
    "joi": "^17.9.2",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "axios": "^1.5.0",
    "@google/generative-ai": "^0.1.3",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
