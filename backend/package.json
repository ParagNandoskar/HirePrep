{
  "name": "hireprep-backend",
  "version": "1.0.0",
  "description": "Backend for HirePrep - AI-powered interview and job matching platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:local": "docker run -d -p 27017:27017 mongo:7.0 && npm run dev",
    "setup": "bash setup.sh",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:local": "docker-compose -f docker-compose.local.yml up -d",
    "python:nlp": "cd nlp-service && python app.py",
    "python:video": "cd python-services && python video_analysis.py",
    "python:audio": "cd python-services && python audio_analysis.py",
    "lint": "echo 'ESLint not configured yet'",
    "format": "echo 'Prettier not configured yet'"
  },
  "keywords": [
    "node",
    "express",
    "mongodb",
    "ai",
    "interviews",
    "jobs"
  ],
  "author": "Duo Developers",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "@aws-sdk/client-secrets-manager": "^3.987.0",
    "@aws-sdk/s3-request-presigner": "^3.913.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/generative-ai": "^0.24.1",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-timeout": "^1.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.10.0",
    "form-data": "^4.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.9.2",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.7.2",
    "validator": "^13.15.26",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "axios": "^1.11.0",
    "node-fetch": "^2.7.0",
    "nodemon": "^3.0.1"
  }
}
