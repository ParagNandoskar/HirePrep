# AWS S3 Configuration (for file uploads)
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=hireprep-resume

# Storage Configuration
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=uploads

# Python Microservices URLs
PYTHON_NLP_SERVICE_URL=http://localhost:5001
PYTHON_VIDEO_SERVICE_URL=http://localhost:8001
PYTHON_AUDIO_SERVICE_URL=http://localhost:8002

# Speech-to-Text Configuration (Choose ONE - Phase 1)
# ===========================================

# Option 1: AssemblyAI (Recommended - Easiest Setup)
# Sign up: https://www.assemblyai.com/
# Cost: $0.37/hour ($0.00617/min)
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Option 2: Google Cloud Speech-to-Text (Best Quality)
# Enable API: https://console.cloud.google.com/apis/library/speech.googleapis.com
# Cost: $0.024/min
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option 3: AWS Transcribe uses existing AWS credentials above
# Cost: $0.024/min

# Option 4: Deepgram (Cheapest)
# Sign up: https://deepgram.com/
# Cost: $0.0125/min
# DEEPGRAM_API_KEY=your_deepgram_key_here

# Video/Audio Analysis Services (Optional - Phase 3)
# ===========================================
VIDEO_ANALYSIS_URL=http://localhost:8001
AUDIO_ANALYSIS_URL=http://localhost:8002

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PAYMENT_MODE=mock

# AI Voice Interview Limits
MIN_BASELINE_QUESTIONS=3
MAX_FOLLOWUPS_PER_PRIMARY=2
MAX_TOTAL_QUESTIONS=7