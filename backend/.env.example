# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-very-long-and-random
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-here-also-very-long-and-random
JWT_REFRESH_EXPIRES_IN=30d

# Google Gemini AI Configuration
GEMINI_API_KEY=AIzaSyDc1fH0Wm7BTIG2auF9dn9ocRQDt4M8R_w

# OpenAI Configuration with Grok Backend (OpenAI-Compatible API)
# Get your Grok API key from: https://console.groq.com/keys
# Uses Grok's OpenAI-compatible endpoint: https://api.groq.com/openai/v1
# Model: llama-3.3-70b-versatile (latest stable model)
OPENAI_API_KEY=gsk-your-groq-api-key-here
GROK_MODEL_NAME=llama-3.3-70b-versatile

# AWS S3 Configuration (for file uploads)
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=hireprep-resume

# Storage Configuration
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=uploads

# Redis / Queue Configuration
# Keep false for local dev if Redis is not running.
REDIS_ENABLED=false
# Optional: disable workers completely in local development.
# ENABLE_WORKERS=false

# Python Microservices URLs (standard)
NLP_SERVICE_URL=http://localhost:5001
RESUME_SERVICE_URL=http://localhost:5001
AUDIO_SERVICE_URL=http://localhost:8001
VIDEO_SERVICE_URL=https://your-ngrok-video-url
VIDEO_CLOUD_SERVICE_URL=http://localhost:8002
VIDEO_SERVICE_MODE=local

# Backward compatibility (legacy variable names)
PYTHON_NLP_SERVICE_URL=http://localhost:5001
PYTHON_AUDIO_SERVICE_URL=http://localhost:8001
PYTHON_VIDEO_SERVICE_URL=http://localhost:8002

# Microservice client timeout
MICROSERVICE_TIMEOUT_MS=10000
MICROSERVICE_RETRY_COUNT=1

# Speech-to-Text Configuration
# Frontend handles STT via Groq Whisper API (e.g., whisper-large-v3-turbo).
# Keep backend free of STT runtime dependencies.

# Optional aliases used by some legacy modules
VIDEO_ANALYSIS_URL=https://your-ngrok-video-url
AUDIO_ANALYSIS_URL=http://localhost:8001

# Optional future feature flag for audio-service module
ENABLE_LOCAL_MODELS=false

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PAYMENT_MODE=mock

# AI Voice Interview Limits
MIN_BASELINE_QUESTIONS=3
MAX_FOLLOWUPS_PER_PRIMARY=2
MAX_TOTAL_QUESTIONS=7