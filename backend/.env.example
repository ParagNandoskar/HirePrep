# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hireprep?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-very-long-and-random
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-here-also-very-long-and-random
JWT_REFRESH_EXPIRES_IN=30d

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# AWS S3 Configuration (for file uploads)
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=hireprep-resume

# Python Microservices URLs
PYTHON_NLP_SERVICE_URL=http://localhost:5001
PYTHON_VIDEO_SERVICE_URL=http://localhost:8001
PYTHON_AUDIO_SERVICE_URL=http://localhost:8002