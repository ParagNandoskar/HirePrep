# Docker Development Environment Variables
# Copy to .env.docker when running Docker setup
# Used by docker-compose.yml

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
FRONTEND_PROD_URL=http://localhost:5173

# ============================================
# Background Job Processing
# ============================================
# Enabled for development/demo - workers run in main server process
ENABLE_WORKERS=true

# ============================================
# Database Configuration (Docker)
# ============================================
MONGODB_URI=mongodb://admin:admin123@mongo:27017/hireprep?authSource=admin
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=5

# ============================================
# Redis Configuration (Docker)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_USERNAME=

# ============================================
# Authentication & Security
# ============================================
JWT_SECRET=dev-secret-key-please-change-in-production-to-random-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-in-production-to-random-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# API Keys (Development)
# ============================================
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# ============================================
# AWS Configuration (Optional)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=hireprep-dev
USE_AWS_SECRETS=false

# ============================================
# File Storage
# ============================================
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# ============================================
# Python Microservices URLs
# ============================================
PYTHON_NLP_SERVICE_URL=http://localhost:5001
PYTHON_VIDEO_SERVICE_URL=http://localhost:8001
PYTHON_AUDIO_SERVICE_URL=http://localhost:8002

# ============================================
# Payment Gateway (Development)
# ============================================
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
PAYMENT_MODE=test

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_DISABLED=false

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug

# ============================================
# CORS Settings
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8081

# ============================================
# AI Interview Configuration
# ============================================
MIN_BASELINE_QUESTIONS=3
MAX_FOLLOWUPS_PER_PRIMARY=2
MAX_TOTAL_QUESTIONS=7

# ============================================
# Testing/Development Flags
# ============================================
SKIP_VALIDATION=false
MOCK_EXTERNAL_SERVICES=false
